# Run migrations with a dedicated migration owner, then grant waf_api to the login below.
DATABASE_URL=postgres://cp_api:replace-me@127.0.0.1:5432/waf?sslmode=disable
API_ADDR=:8081
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
NATS_URL=nats://127.0.0.1:4222
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=no-reply@example.test
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Base64 raw Ed25519 private seed (32 bytes) or private key (64 bytes).
JWT_ED25519_PRIVATE_KEY=
# Base64-encoded key material; minimum 32 bytes; used only to encrypt TOTP secrets.
TOTP_ENCRYPTION_KEY=
