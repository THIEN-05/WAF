POSTGRES_USER=waf
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=waf
POSTGRES_DSN=postgres://waf:change-me-local@localhost:5432/waf?sslmode=disable
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222
CLICKHOUSE_URL=http://localhost:8123
S3_ACCESS_KEY=waf
S3_SECRET_KEY=change-me-local
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=waf-dev
MAILHOG_SMTP=localhost:1025
MAILHOG_UI=http://localhost:8025
EDGE_ADDR=:8080
EDGE_GEOIP_COUNTRY_MMDB=
EDGE_GEOIP_ASN_MMDB=
EDGE_GLOBAL_BLOCKLIST_CIDRS=
# Dev/operator-provisioned HMAC keys: key_id=base64,key_id=base64 (minimum 32 bytes each).
EDGE_CHALLENGE_HMAC_KEYS=
EDGE_CHALLENGE_HMAC_ACTIVE_KEY_ID=
API_ADDR=:8081
APP_ENV=development
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
# Internal edge CA key file path only; on Linux use a file outside the repo with mode 0600.
EDGE_CA_CERT_FILE=
EDGE_CA_KEY_FILE=
# Bind to loopback by default. Set an internal interface address in deployment;
# firewall this listener from the public Internet.
WORKER_ADDR=127.0.0.1:8082
WORKER_TLS_CERT_FILE=
WORKER_TLS_KEY_FILE=
# Optional in development: the worker generates an ephemeral CA in memory when unset.
EDGE_CLIENT_CA_FILE=
INGEST_ADDR=:8083
